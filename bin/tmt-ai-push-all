#!/usr/bin/env bash
#
# tmt-ai-push-all — from a projects directory, push every unpushed claude/*
# branch of every git repo one level down, and print exactly what was pushed
# so you can review it. Host-side helper: the container has no push credentials.
#
# Only claude/* is pushed by default; never force-pushes; never touches master
# or any other branch unless you pass --push-others. A diverged branch is
# rejected, not overwritten.
#
# Usage:
#   tmt-ai-push-all                 # scan ./*, preview, confirm, push claude/*
#   tmt-ai-push-all <dir>           # scan <dir>/* instead of the cwd
#   tmt-ai-push-all --yes           # skip the confirmation
#   tmt-ai-push-all --dry-run       # show what would be pushed, push nothing
#   tmt-ai-push-all --show-others   # also LIST unpushed non-claude/* branches
#   tmt-ai-push-all --push-others   # also PUSH them (master/feature too)
#   tmt-ai-push-all --open          # open each "create PR" URL in a browser
#   tmt-ai-push-all -r <remote>     # remote name (default: origin)
#
# Bitbucket/GitHub don't create a PR on push — they only print a "create pull
# request" URL. This tool collects those URLs and prints them at the end (and
# opens them with --open). Actually creating the PR needs their REST API.
#
# After pushing it also prints, per project, a suggested PR target branch
# (main/master/dev/develop — whichever is most ahead of the others, the base
# these branches split from) plus ready-made GitHub compare URLs. Mirrors the
# suggestion bin/tmt-ai-push prints for a single project.
#
# "Unpushed" is counted against local remote-tracking refs, so run
# `git fetch --all` first if those might be stale.
#
# Resilient batch tool: one repo failing (auth, a diverged branch, a weird
# state) must NEVER abort the whole sweep. So we run WITHOUT errexit/nounset/
# pipefail on purpose — every step below is checked explicitly and failures are
# counted, not fatal. Strict mode kept turning one repo's edge case into a dead
# run: pipefail+SIGPIPE mid-listing, then nounset on an empty array at the end.
set +eu
shopt -s nullglob

REMOTE=origin
ASSUME_YES=0
DRY=0
SHOW_OTHERS=0
PUSH_OTHERS=0
OPEN=0
ROOT="."

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) ASSUME_YES=1; shift ;;
        -n|--dry-run) DRY=1; shift ;;
        -o|--show-others) SHOW_OTHERS=1; shift ;;
        -O|--push-others) PUSH_OTHERS=1; shift ;;
        --open) OPEN=1; shift ;;
        -r|--remote) REMOTE="${2:?--remote needs a value}"; shift 2 ;;
        -h|--help)
            grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed -n '2,31p'
            exit 0 ;;
        -*) echo "unknown option: $1" >&2; exit 2 ;;
        *) ROOT="$1"; shift ;;
    esac
done

# Pushing the others implies listing them.
[ "$PUSH_OTHERS" -eq 1 ] && SHOW_OTHERS=1

[ -d "$ROOT" ] || { echo "not a directory: $ROOT" >&2; exit 1; }

# With a terminal, leave git's credential prompt on so HTTPS remotes can ask for
# a username/password. With NO terminal (cron, piped --yes), make git fail fast
# on a credential-less remote instead of hanging on an invisible prompt.
[ -r /dev/tty ] || export GIT_TERMINAL_PROMPT=0

# Scan: claude/* unpushed → P_*, every other unpushed branch → O_*.
declare -a P_REPO P_BRANCH P_AHEAD
declare -a O_REPO O_BRANCH O_AHEAD
for d in "$ROOT"/*/; do
    d="${d%/}"
    git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
    git -C "$d" remote | grep -qx "$REMOTE" || continue   # skip repos without this remote
    while IFS= read -r b; do
        [ -n "$b" ] || continue
        ahead="$(git -C "$d" rev-list --count "$b" --not --remotes="$REMOTE" 2>/dev/null || echo 0)"
        [ "$ahead" -gt 0 ] 2>/dev/null || continue
        case "$b" in
            claude/*) P_REPO+=("$d"); P_BRANCH+=("$b"); P_AHEAD+=("$ahead") ;;
            *)        O_REPO+=("$d"); O_BRANCH+=("$b"); O_AHEAD+=("$ahead") ;;
        esac
    done < <(git -C "$d" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)
done

ROOT_ABS="$(cd "$ROOT" && pwd)"

# Grouped listing with per-commit lines. Args: <REPO_arr> <BRANCH_arr> <AHEAD_arr>
list_branches() {
    local -n _repo=$1 _branch=$2 _ahead=$3
    local last="" i
    for i in "${!_repo[@]}"; do
        [ "${_repo[$i]}" = "$last" ] || { echo "  ${_repo[$i]##*/}/"; last="${_repo[$i]}"; }
        echo "    ${_branch[$i]}  (${_ahead[$i]} unpushed)"
        git -C "${_repo[$i]}" log -n 10 --format='        %h %s' "${_branch[$i]}" \
            --not --remotes="$REMOTE" 2>/dev/null || true
    done
}

# What to do about non-claude/* branches when we're NOT pushing them:
#   --show-others → list them with a ready-to-run push command
#   default       → a single hidden-count line so they're never fully silent
others_note() {
    [ "${#O_REPO[@]}" -gt 0 ] || return 0
    [ "$PUSH_OTHERS" -eq 1 ] && return 0            # already in the push plan
    if [ "$SHOW_OTHERS" -eq 1 ]; then
        echo
        echo "Non-claude/* branches with unpushed commits (NOT pushed — use --push-others):"
        local last="" i
        for i in "${!O_REPO[@]}"; do
            [ "${O_REPO[$i]}" = "$last" ] || { echo "  ${O_REPO[$i]##*/}/"; last="${O_REPO[$i]}"; }
            echo "    ${O_BRANCH[$i]}  (${O_AHEAD[$i]} unpushed)  → git -C \"${O_REPO[$i]}\" push $REMOTE ${O_BRANCH[$i]}"
        done
    else
        echo "(${#O_REPO[@]} unpushed non-claude/* branch(es) hidden — --show-others to list, --push-others to push.)"
    fi
}

# Suggest the PR target for one repo: among main/master/dev/develop, the local
# branch with the most commits the others don't have (tie-break: newest commit).
# Matches the base the dashboard split these branches from. Mirrors tmt-ai-push.
# Echoes the base branch name, or nothing if none of those branches exist.
suggest_base() {
    local dir="$1" c o not n t BASE="" bestn=-1 bestt=-1
    for c in main master dev develop; do
        git -C "$dir" show-ref --verify --quiet "refs/heads/$c" || continue
        not=""
        for o in main master dev develop; do
            [ "$o" = "$c" ] && continue
            git -C "$dir" show-ref --verify --quiet "refs/heads/$o" && not="$not ^refs/heads/$o"
        done
        # shellcheck disable=SC2086
        n="$(git -C "$dir" rev-list --count "refs/heads/$c" $not -- 2>/dev/null || echo 0)"
        t="$(git -C "$dir" log -1 --format=%ct "refs/heads/$c" 2>/dev/null || echo 0)"
        if [ "$n" -gt "$bestn" ] || { [ "$n" -eq "$bestn" ] && [ "$t" -gt "$bestt" ]; }; then
            BASE="$c"; bestn="$n"; bestt="$t"
        fi
    done
    printf '%s' "$BASE"
}

# Echo the "host/path" of a repo's remote URL when it's a recognisable web host,
# so compare URLs can be built. Empty for unknown/opaque remotes.
remote_host_path() {
    local dir="$1" url hp=""
    url="$(git -C "$dir" remote get-url "$REMOTE" 2>/dev/null || true)"
    url="${url%.git}"
    case "$url" in
        git@*)       hp="${url#git@}"; hp="${hp/:/\/}" ;;
        ssh://git@*) hp="${url#ssh://git@}" ;;
        https://*)   hp="${url#https://}" ;;
    esac
    printf '%s' "$hp"
}

# Nothing to push? (claude/*, plus others only when --push-others)
push_count=${#P_REPO[@]}
[ "$PUSH_OTHERS" -eq 1 ] && push_count=$((push_count + ${#O_REPO[@]}))
if [ "$push_count" -eq 0 ]; then
    echo "No unpushed claude/*$([ "$PUSH_OTHERS" -eq 1 ] && echo " or other") branches under $ROOT_ABS (remote '$REMOTE')."
    others_note
    exit 0
fi

if [ "${#P_REPO[@]}" -gt 0 ]; then
    echo "Unpushed claude/* branches under $ROOT_ABS → '$REMOTE':"
    echo
    list_branches P_REPO P_BRANCH P_AHEAD
    echo
fi

if [ "$PUSH_OTHERS" -eq 1 ] && [ "${#O_REPO[@]}" -gt 0 ]; then
    echo "Also pushing NON-claude/* branches (master/feature — because --push-others) → '$REMOTE':"
    echo
    list_branches O_REPO O_BRANCH O_AHEAD
    echo
fi

if [ "$DRY" -eq 1 ]; then
    echo "[dry-run] would push the above. Re-run without --dry-run to push."
    others_note
    exit 0
fi

if [ "$ASSUME_YES" -ne 1 ]; then
    prompt="Push claude/* to '$REMOTE'"
    [ "$PUSH_OTHERS" -eq 1 ] && [ "${#O_REPO[@]}" -gt 0 ] &&
        prompt="Push claude/* AND the non-claude branches above to '$REMOTE'"
    # Read the answer from the real terminal, and first drain any keystrokes
    # typed while we were scanning (an impatient Enter must NOT be consumed as
    # the answer, which would silently "abort"). No tty → require --yes.
    if [ -r /dev/tty ]; then
        while IFS= read -r -t 0.1 _ </dev/tty 2>/dev/null; do :; done
        printf '%s? [y/N] ' "$prompt" >/dev/tty
        IFS= read -r reply </dev/tty || reply=""
    else
        echo "no terminal for the confirmation prompt — re-run with --yes to push." >&2
        exit 1
    fi
    case "$reply" in y|Y|yes|YES) ;; *) echo "aborted."; exit 0 ;; esac
fi

# Assemble the push list: claude/* always, others only with --push-others.
declare -a PUSH_REPO PUSH_BRANCH
for i in "${!P_REPO[@]}"; do PUSH_REPO+=("${P_REPO[$i]}"); PUSH_BRANCH+=("${P_BRANCH[$i]}"); done
if [ "$PUSH_OTHERS" -eq 1 ]; then
    for i in "${!O_REPO[@]}"; do PUSH_REPO+=("${O_REPO[$i]}"); PUSH_BRANCH+=("${O_BRANCH[$i]}"); done
fi

echo
pushed=0; failed=0
declare -A DONE_REPO
declare -a PR_URLS
# Successfully-pushed branches grouped per repo, for the PR-target suggestion.
declare -A SUCC_BRANCHES
declare -a SUCC_ORDER
for i in "${!PUSH_REPO[@]}"; do
    r="${PUSH_REPO[$i]}"; b="${PUSH_BRANCH[$i]}"
    printf '== %s : %s ==\n' "${r##*/}" "$b"
    # Capture the push output (the "create pull request" URL is printed by the
    # remote on stderr) while still streaming it live via tee. Check git's own
    # exit status, not tee's — pipefail is off, so use PIPESTATUS.
    out="$(mktemp)"
    git -C "$r" push "$REMOTE" "refs/heads/$b:refs/heads/$b" 2>&1 | tee "$out"
    rc=${PIPESTATUS[0]}
    if [ "$rc" -eq 0 ]; then
        pushed=$((pushed + 1)); DONE_REPO["$r"]=1
        [ -n "${SUCC_BRANCHES[$r]+x}" ] || SUCC_ORDER+=("$r")
        SUCC_BRANCHES["$r"]+="$b"$'\n'
        # Bitbucket: .../pull-requests/new?source=<branch>...
        # GitHub:    .../pull/new/<branch>  (or /compare/...)
        url="$(grep -oE 'https://[^ ]*/(pull-requests/new|pull/new|compare)[^ ]*' "$out" | head -n1)"
        [ -n "$url" ] && PR_URLS+=("${r##*/}  $b  $url")
    else
        echo "  !! push failed — auth, a non-fast-forward, or a remote error"
        echo "     (never force-pushed; see git's output above). Skipping this one."
        failed=$((failed + 1))
    fi
    rm -f "$out"
    echo
done

if [ "${#PR_URLS[@]}" -gt 0 ]; then
    echo "Create pull requests:"
    for u in "${PR_URLS[@]}"; do echo "  $u"; done
    echo
    if [ "$OPEN" -eq 1 ]; then
        if command -v xdg-open >/dev/null 2>&1; then
            for u in "${PR_URLS[@]}"; do xdg-open "${u##* }" >/dev/null 2>&1 & done
        else
            echo "(--open: no xdg-open on this host — open the URLs above manually.)"
        fi
    fi
fi

# Per-project PR-target suggestion (only for repos we actually pushed to).
if [ "${#SUCC_ORDER[@]}" -gt 0 ]; then
    echo "Suggested PR target per project (base most ahead of main/master/dev — where these branches split from):"
    for r in "${SUCC_ORDER[@]}"; do
        base="$(suggest_base "$r")"
        if [ -z "$base" ]; then
            echo "  ${r##*/}/  → (no main/master/dev/develop branch to target)"
            continue
        fi
        echo "  ${r##*/}/  → '$base'"
        hp="$(remote_host_path "$r")"
        case "$hp" in
            *github*)
                while IFS= read -r b; do
                    [ -n "$b" ] && [ "$b" != "$base" ] || continue
                    echo "      https://$hp/compare/$base...$b?expand=1"
                done <<< "${SUCC_BRANCHES[$r]}" ;;
        esac
    done
    echo
fi

echo "Pushed $pushed branch(es) across ${#DONE_REPO[@]} repo(s); $failed failed."
others_note
[ "$failed" -eq 0 ]
